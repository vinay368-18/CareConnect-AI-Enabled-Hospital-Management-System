# ==============================================================================
# CareConnect HMS - Environment Configuration Template
# ==============================================================================
# Easiest: run scripts\setup-config.bat, which writes these settings to
#   %USERPROFILE%\.careconnect\careconnect.env   (outside the project folder)
# Or copy this file there by hand and fill it in. Environment variables, when
# set, take precedence. Both the web app and the AI service read that file.
# NEVER COMMIT A FILE CONTAINING REAL CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# Database Configuration (MySQL)
HMS_DB_URL=jdbc:mysql://localhost:3306/hospital?useSSL=true&requireSSL=false&serverTimezone=UTC
HMS_DB_USER=hms_app
HMS_DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# Python Retinal CVD AI Microservice
HMS_AI_API_URL=http://127.0.0.1:5000
HMS_AI_API_KEY=YOUR_RANDOMLY_GENERATED_32_CHAR_HEX_KEY_HERE
HMS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
